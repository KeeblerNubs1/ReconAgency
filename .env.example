TELEGRAM_BOT_TOKEN=
# The Telegram account that can add and remove admins with bot commands.
OWNER_TELEGRAM_USER_ID=
# API credentials from my.telegram.org. They are retained for deployments that also use
# Telegram client APIs; this Bot API application authenticates with TELEGRAM_BOT_TOKEN.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_DISPLAY_NAME=Meeting Bot
HEADLESS=true
LOG_LEVEL=INFO
CHROME_PROFILE_DIR=/data/chrome-profile
STATE_DIR=/data
